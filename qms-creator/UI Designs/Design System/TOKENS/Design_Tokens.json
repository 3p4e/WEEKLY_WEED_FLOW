          "4xl": "40px"
        },
        "weights": {
          "normal": 400,
          "medium": 500,
          "semibold": 600,
          "bold": 700
        },
        "lineHeights": {
          "tight": 1.2,
          "normal": 1.5,
          "loose": 1.75
        }
