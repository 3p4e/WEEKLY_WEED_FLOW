# Cannabis QMS Creator - Environment Configuration
# Copy this file to .env and update values for your environment

# ============================================================================
# BACKEND CONFIGURATION
# ============================================================================

# API Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Security — the backend rejects requests to protected endpoints unless the
# X-API-Key header matches this value. The frontend picks it up via VITE_API_KEY.
API_KEY=change-me-in-production
VITE_API_KEY=change-me-in-production

# Logging
LOG_LEVEL=INFO

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=qms
DB_USER=qmsuser
DB_PASSWORD=changeme

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# API Base URL (used by frontend to connect to backend)
VITE_API_BASE=http://localhost:8000

# ============================================================================
# OPTIONAL EXTERNAL SERVICES
# ============================================================================

# OpenAI (optional - for advanced RAG features)
OPENAI_API_KEY=

# Anthropic Claude (optional - for advanced RAG features)
ANTHROPIC_API_KEY=

# Ollama (optional - for local LLM inference)
OLLAMA_URL=http://72.61.176.37:11434

# ============================================================================
# DOCKER ENVIRONMENT
# ============================================================================

# Set to 'production' or 'development'
ENVIRONMENT=development

# Python version (for Docker builds)
PYTHON_VERSION=3.12

# Node version (for Docker builds)
NODE_VERSION=22

# ============================================================================
# LETTA STATEFUL AGENTS (the live AI engine)
# ============================================================================

# Base URL of the self-hosted Letta server (kvm4). When the API runs on the
# same host, localhost is correct; otherwise point at the server's address.
LETTA_BASE_URL=http://localhost:8283
# Server auth token — required by the secured kvm4 server; leave blank for an
# unsecured local dev server (the client then uses "local").
LETTA_API_KEY=

# Embedding model for this app's own archives — must be a handle the server
# actually serves (the kvm4 server exposes OpenAI-family handles).
LETTA_EMBEDDING_MODEL=openai/text-embedding-3-small

# Hybrid agent strategy: this app creates its own per-section authoring agents,
# but reuses these shared specialists already on the server for research + RAG.
# Override only if the server uses different agent names.
LETTA_COMPLIANCE_AGENT=eu_gmp_compliance_expert
LETTA_RAG_AGENT=gmp_rag_agent

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Comma-separated list of allowed origins (production only)
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:80

# ============================================================================
# RATE LIMITING
# ============================================================================

# Rate limit configuration (in requests per minute)
RATE_LIMIT_GENERAL=300
RATE_LIMIT_API=100
RATE_LIMIT_GENERATION=30

# ============================================================================
# DOCUMENT STORAGE
# ============================================================================

# S3 Storage (optional - for document backups)
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# ============================================================================
# MONITORING AND LOGGING
# ============================================================================

# Sentry (optional - for error tracking)
SENTRY_DSN=

# Log storage location
LOG_FILE_PATH=/app/logs

# ============================================================================
# EMAIL CONFIGURATION (optional)
# ============================================================================

SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ============================================================================
# SESSION AND SECURITY
# ============================================================================

# Session timeout (in minutes)
SESSION_TIMEOUT=1440

# HTTPS (for production)
USE_HTTPS=false
SSL_CERT_PATH=
SSL_KEY_PATH=
