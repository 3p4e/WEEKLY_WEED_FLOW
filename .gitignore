# Python / backend
__pycache__/
*.py[cod]
.venv/
venv/
env/
# backend/scripts/run_e2e_backend.sh sources backend/.venv/bin/activate; a
# local e2e run may satisfy that with a SYMLINK to a venv elsewhere. The
# `.venv/` pattern above is directory-only and git treats a symlink as a
# file, so the symlink form needs its own entry — never commit either.
/backend/.venv
.env
*.egg-info/

# Node / tooling (if added later)
node_modules/
dist/
build/

# Playwright (web/e2e)
test-results/
playwright-report/
blob-report/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logs / local
*.log
.cache/

# rclone config for the offsite-backup service — holds the Google Drive OAuth
# token + crypt password pair; lives only on the deploy host, never in git.
rclone/
test_accounts.local.json

# Local demo-video recordings (delivered via Google Drive, never committed)
.demo-videos/

# DocEngine (Python service)
docengine/__pycache__/
docengine/**/__pycache__/
docengine/.pytest_cache/
docengine/.venv/
.coverage
htmlcov/

# agent scratch / never commit credentials
.a0proj/
**/.a0proj/
*cookies*.txt
*cookies*.json
auth_url.txt
