# ── WEEKLY_WEED_FLOW API configuration ─────────────────────────────────────
# Copy to `.env` (or pass as container env). Maps to app/config.py (Settings).

# "production" (default) refuses to start with the placeholder SECRET_KEY
# below. Set to "development" for local work so first-time setup doesn't
# require generating a key immediately.
ENVIRONMENT=development

# Two DSNs → two Postgres roles. app_user is NOBYPASSRLS (request handlers,
# RLS-scoped); app_admin is BYPASSRLS (auth lookups + provisioning + the
# audit-chain verifier). Use strong, distinct passwords in production.
DATABASE_URL=postgresql://app_user:CHANGE_ME@weekly_weed_flow-db-1:5432/weekly_weed_flow
ADMIN_DATABASE_URL=postgresql://app_admin:CHANGE_ME@weekly_weed_flow-db-1:5432/weekly_weed_flow

# JWT signing key (HS256). Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=15
REMEMBER_DEVICE_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=12

# AI / Letta (always-on layer). The backend proxies AI functions to a Letta
# stateful agent; credentials never touch the browser.
LETTA_BASE_URL=http://host.docker.internal:8283
LETTA_MCP_URL=http://host.docker.internal:6507
QDRANT_URL=http://host.docker.internal:6333
LETTA_API_KEY=

# CORS / public host. Set CORS_ORIGINS to the real scheme+host in production
# (comma-separated for multiple) — the wildcard is a local-dev convenience.
CORS_ORIGINS=*
APP_HOST=wwf.srv1231216.hstgr.cloud

# Alembic migrations only (not read by the running app / app/config.py).
# Needs DDL privileges app_user/app_admin intentionally don't have — a
# postgres-superuser-class DSN, SQLAlchemy's asyncpg driver URL form.
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@weekly_weed_flow-db-1:5432/weekly_weed_flow
