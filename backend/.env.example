# ── GrowFlow AI Gateway configuration ──────────────────────────────────────
# Copy to `.env` and adjust. Loaded by docker-compose / your process manager.

# Where the Letta server is reachable from THIS gateway.
# On KVM4, if the gateway runs on the same host as the Letta container, use the
# compose service name or localhost; otherwise use the private network address.
LETTA_BASE_URL=http://letta:8283

# Optional bearer token if your Letta server enforces auth (SECURE mode).
LETTA_TOKEN=

# Model + embedding *handles* — must match a provider already configured in
# your Letta server (OpenAI, Anthropic, Ollama, vLLM, etc.).
LETTA_MODEL=openai/gpt-4o-mini
LETTA_EMBEDDING=openai/text-embedding-3-small

# Prefix for per-user agent names (growflow-<userId>).
LETTA_AGENT_PREFIX=growflow

# Comma-separated allowed browser origins for CORS. Use your real app origin
# in production instead of "*".
GROWFLOW_ALLOWED_ORIGINS=*
