# ════════════════════════════════════════════════════════════════════════
#  WWF — Weekly Weed Flow : single-stack environment
#  Copy to `.env` (never commit .env) and fill in real values, then:
#     docker compose up -d --build
# ════════════════════════════════════════════════════════════════════════

# ── Hosting / Traefik (KVM4: Ubuntu 24.04 + Docker + Traefik) ───────────────
APP_HOST=wwf.example.com           # public hostname routed by Traefik
TRAEFIK_NETWORK=traefik            # external Traefik docker network name
TRAEFIK_CERTRESOLVER=letsencrypt   # Traefik ACME resolver for auto-HTTPS
WEB_PORT=8080                      # host port -> web (direct access / fallback)
GATEWAY_PORT=8000                  # host port -> gateway (direct access / fallback)
GROWFLOW_ALLOWED_ORIGINS=https://wwf.example.com

# ── Letta stateful agents (KVM4) ────────────────────────────────────────────
# Reachable from the gateway container. If Letta runs on the same host with its
# port published, host.docker.internal works; otherwise set the full URL.
LETTA_BASE_URL=http://host.docker.internal:8283
LETTA_TOKEN=
LETTA_API_KEY=                     # from the environment (do NOT hardcode)
LETTA_MODEL=openai/gpt-4o-mini
LETTA_EMBEDDING=openai/text-embedding-3-small
LETTA_AGENT_PREFIX=growflow

# ── Task-capture store = the Letta database (stateful agents' Postgres+pgvector)
# We do NOT use the Supabase suma_db. Tasks are captured through the Letta agents
# and persisted in Letta's own backing database. Set LETTA_DB_URL only if the
# gateway needs direct DB access (analytics); otherwise the Letta API is enough.
LETTA_DB_URL=postgresql+psycopg://letta:PASSWORD@host.docker.internal:5432/letta

# ── Vector DB + embeddings (RAG: Letta <-> Qdrant) ──────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
VOYAGE_API_KEY=                    # VoyageAI embeddings

# ── Auth (JWT HS256) ────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=12
