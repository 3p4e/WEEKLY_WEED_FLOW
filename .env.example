# ════════════════════════════════════════════════════════════════════════
#  WEEKLY_WEED_FLOW — environment for the deployed stack (docker-compose.yml).
#  Copy to `.env` (never commit it) and fill in real values.
#  Maps to backend/app/config.py (Settings) plus the db + frontend services.
# ════════════════════════════════════════════════════════════════════════

# "production" (default) refuses to start with the placeholder SECRET_KEY
# below — this deployment should always be production. Only override to
# "development" for a local docker-compose run.
ENVIRONMENT=production

# ── Databases ───────────────────────────────────────────────────────────────
# Superuser password for BOTH Postgres containers (initdb). The db-backup
# container assumes the two share it.
POSTGRES_PASSWORD=change-me

# Two databases (identity vs work data), each reached through two roles:
# app_user is NOBYPASSRLS (request handlers, RLS-scoped); app_admin is
# BYPASSRLS (auth lookups + provisioning + audit-chain verify). The roles +
# their table GRANTs are a one-time bootstrap IN EACH database (docs/DEPLOY.md).
USERS_DATABASE_URL=postgresql://app_user:change-me@wwf-db-users:5432/wwf_users
USERS_ADMIN_DATABASE_URL=postgresql://app_admin:change-me@wwf-db-users:5432/wwf_users
TASKS_DATABASE_URL=postgresql://app_user:change-me@wwf-db-tasks:5432/wwf_tasks
TASKS_ADMIN_DATABASE_URL=postgresql://app_admin:change-me@wwf-db-tasks:5432/wwf_tasks

# ── Auth (JWT HS256) ────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
# 12 is also the PRODUCTION FLOOR (backend/app/config.py): a lower value is
# raised back to 12 unless PASSWORD_POLICY_OVERRIDE=true is set alongside it,
# and either way the backend logs a warning at every start. Only development
# (ENVIRONMENT=development) is exempt.
PASSWORD_MIN_LENGTH=12
# PASSWORD_POLICY_OVERRIDE=true

# ── AI / Letta (always-on layer; credentials never reach the browser) ───────
# LOCAL-DEV values, reaching a Letta you run yourself over
# host.docker.internal. Do NOT hardcode keys in the repo.
#
# Production points at letta-code (letta-6ou3-letta-1) across the ai-net
# Docker network and is configured in app.env on the host, not from this
# template — see docs/LETTA-CUTOVER-PHASE1-2026-08-22.md.
#
# LETTA_MCP_URL and QDRANT_URL were listed here and are deliberately removed:
# no backend code reads either one, so they only implied a live dependency.
LETTA_BASE_URL=http://host.docker.internal:8283
LETTA_API_KEY=

# ── Hosting / Traefik ───────────────────────────────────────────────────────
APP_HOST=wwf.srv1231216.hstgr.cloud   # public hostname routed by Traefik (websecure)
# Set to the real scheme+host (comma-separated for multiple) — the wildcard
# is a local-dev convenience, not meant for a production deployment.
CORS_ORIGINS=https://wwf.srv1231216.hstgr.cloud

# ── Schema migrations (Alembic; not read by the running app) ────────────────
# Needs DDL privileges app_user/app_admin intentionally don't have — a
# postgres-superuser-class DSN per database. Invoke with
# `alembic -n users|tasks upgrade head`. See docs/DEPLOY.md.
USERS_MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:change-me@wwf-db-users:5432/wwf_users
TASKS_MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:change-me@wwf-db-tasks:5432/wwf_tasks

# ── Weekly snapshot scheduler (wwf-scheduler container; scripts/scheduler.py) ─
# Fires the report/plan generator every Thursday 14:00 in this timezone.
# SNAPSHOT_TZ also drives work-session overtime/night/weekend classification.
SNAPSHOT_TZ=Europe/Skopje
# On restart, run a missed Thursday fire only if it was this many hours ago.
SNAPSHOT_GRACE_HOURS=24
# Letta RAG source the Markdown digests are uploaded to (0 files until first run).
LETTA_SNAPSHOT_SOURCE_ID=source-7ad49834-0436-4f45-8214-7e1f7e3c9fa9
LETTA_SNAPSHOT_SOURCE_NAME=GrowFlow_Weekly_Snapshots
# Letta planner agents (env fallback; per-org ai_agent_bindings rows win).
LETTA_WEEKLY_REPORT_AGENT_ID=
LETTA_NEXT_WEEK_PLAN_AGENT_ID=
# Coordinator the RAG source is attached to at scheduler startup / --attach-source.
LETTA_COORDINATOR_AGENT_ID=

# ── DocEngine (wwf-docengine; docengine/) ───────────────────────────────────
# NOT read from this file. The docengine service takes its environment from a
# separate `docengine.env` beside compose.yaml (docker-compose.yml, env_file),
# so the Letta and RAGflow tenant keys never sit in the backend's environment.
# Create it from these keys; the two the backend needs (DOCENGINE_URL and
# DOCENGINE_API_KEY, same secret) go in the backend's .env / app.env.
#
#   DOCENGINE_API_KEY=<openssl rand -hex 32; the backend sends it as X-API-Key>
#   # Its OWN role, rights on schema `docengine` only — never app_admin.
#   # Create it with docengine/sql/docengine_role.sql (docs/DEPLOY.md).
#   DOCENGINE_DATABASE_URL=postgresql://docengine:change-me@wwf-db-tasks:5432/wwf_tasks
#   DOCENGINE_OUT_DIR=/data/docengine-out
#   DOCENGINE_MAX_REPAIR_ROUNDS=2
#   DOCENGINE_FLEET_CACHE_S=600
#   LETTA_BASE_URL=http://letta-6ou3-letta-1:8283
#   LETTA_API_KEY=
#   LETTA_READ_TIMEOUT=900
#   LETTA_CONNECT_TIMEOUT=15
#   RAGFLOW_BASE_URL=http://ragflow-ragflow-cpu-1:9380
#   RAGFLOW_API_KEY=
#   GOTENBERG_URL=http://gotenberg:3000
DOCENGINE_URL=http://wwf-docengine:8000
DOCENGINE_API_KEY=

# ── Capture connector (wwf-capture-mcp; connector/server.py) ────────────────
# Static token the connector presents to POST /capture/import — valid ONLY on
# that route, acting as CAPTURE_IMPORT_USER (an ADMIN-equivalent account on an
# internet-reachable route). Generate: openssl rand -hex 24. The backend treats
# a placeholder or anything shorter than 32 characters as UNSET (the route then
# accepts only normal user sessions) and warns at startup, so a copied template
# can never be a working credential. docker-compose refuses to start without it.
CAPTURE_IMPORT_TOKEN=
CAPTURE_IMPORT_USER=qcm.blani
# Secret URL path the MCP server listens on (the connector's only exposure).
# Generate a random slug: /mcp-$(openssl rand -hex 8)
CAPTURE_MCP_PATH=/mcp-change-me
