@@ -0,0 +1,257 @@
+"""
+Specification validation service — triple-tier pass→alert→fail engine.
+
+Per QCSP 003 (TD1-DF400) dual LOD limits and QCSOP 012 §A01.2 conformance check.
+
+Validates a TestResult against an active SpecParameter's dual limits:
+- operational_limit_min/max: alert threshold, triggers investigation
+- release_limit_min/max: hard limit, batch fails if breached
+
+Tiers:
+1. PASS: within operational limits → fully compliant, no action needed
+2. ALERT: between operational and release limits → compliant but investigate
+3. FAIL: outside release limits → non-compliant, OOS trigger
+"""
+
+import logging
+from dataclasses import dataclass, field
+from enum import StrEnum
+from typing import Optional
+
+logger = logging.getLogger(__name__)
+
+
+class ValidationTier(StrEnum):
+    """Validation outcome tier."""
+    PASS = "pass"
+    ALERT = "alert"
+    FAIL = "fail"
+    ERROR = "error"  # No spec found, spec not effective, etc.
+
+
+class LimitType(StrEnum):
+    """Which limit boundary was relevant."""
+    WITHIN_OPERATIONAL = "within_operational"
+    OPERATIONAL_BREACH = "operational_breach"
+    RELEASE_BREACH = "release_breach"
+    CATEGORICAL_MATCH = "categorical_match"
+    CATEGORICAL_MISMATCH = "categorical_mismatch"
+    NOT_APPLICABLE = "not_applicable"
+
+
+@dataclass
+class ValidationResult:
+    """Result of validating a single test result against a spec parameter."""
+
+    complies: Optional[bool]  # None when error (no spec found)
+    status: str  # pass | alert | fail | error
+    limit_type: str  # within_operational | operational_breach | release_breach | categorical_match | etc.
+    spec_parameter_id: Optional[str] = None
+    spec_parameter_name: Optional[str] = None
+    alert_message: Optional[str] = None
+    result_value: Optional[str] = None
+    spec_limit_display: Optional[str] = None
+
+
+def validate_result(
+    result_value: str | None,
+    result_numeric: float | None,
+    spec_parameter: dict | None,
+) -> ValidationResult:
+    """
+    Validate a single test result against a specification parameter.
+
+    Args:
+        result_value: String representation of the test result.
+        result_numeric: Numeric representation of the test result (from TestResult model).
+        spec_parameter: Dict with keys from SpecParameter model:
+            - id, test_name_en
+            - spec_type: NUMERIC_BOUNDED | NUMERIC_MAX | NUMERIC_MIN | CATEGORICAL | TEXT
+            - operational_limit_min/max: float | None
+            - release_limit_min/max: float | None
+            - unit: str
+            - categorical_values: list[str] | None
+
+    Returns:
+        ValidationResult with compliance status, tier, limit type, and messages.
+    """
+    # ── No spec found ────────────────────────────────────────────────────
+    if spec_parameter is None:
+        return ValidationResult(
+            complies=None,
+            status=ValidationTier.ERROR.value,
+            limit_type=LimitType.NOT_APPLICABLE.value,
+            alert_message="No specification parameter found for this test",
+            result_value=result_value,
+        )
+
+    spec_type = spec_parameter.get("spec_type", "TEXT")
+    spec_name = spec_parameter.get("test_name_en", "Unknown")
+    spec_id = str(spec_parameter.get("id", ""))
+    unit = spec_parameter.get("unit", "")
+
+    # ── CATEGORICAL ──────────────────────────────────────────────────────
+    if spec_type == "CATEGORICAL":
+        categorical_values = spec_parameter.get("categorical_values") or []
+        if result_value in categorical_values:
+            return ValidationResult(
+                complies=True,
+                status=ValidationTier.PASS.value,
+                limit_type=LimitType.CATEGORICAL_MATCH.value,
+                spec_parameter_id=spec_id,
+                spec_parameter_name=spec_name,
+                result_value=result_value,
+                spec_limit_display=f"One of: {', '.join(categorical_values)}",
+            )
+        else:
+            return ValidationResult(
+                complies=False,
+                status=ValidationTier.FAIL.value,
+                limit_type=LimitType.CATEGORICAL_MISMATCH.value,
+                spec_parameter_id=spec_id,
+                spec_parameter_name=spec_name,
+                alert_message=f"'{result_value}' not in allowed values: {categorical_values}",
+                result_value=result_value,
+                spec_limit_display=f"One of: {', '.join(categorical_values)}",
+            )
+
+    # ── TEXT ─────────────────────────────────────────────────────────────
+    if spec_type == "TEXT":
+        return ValidationResult(
+            complies=None,
+            status=ValidationTier.PASS.value,
+            limit_type=LimitType.NOT_APPLICABLE.value,
+            spec_parameter_id=spec_id,
+            spec_parameter_name=spec_name,
+            result_value=result_value,
+            spec_limit_display="Text — no numeric limits",
+        )
+
+    # ── NUMERIC ──────────────────────────────────────────────────────────
+    if result_numeric is None:
+        return ValidationResult(
+            complies=None,
+            status=ValidationTier.ERROR.value,
+            limit_type=LimitType.NOT_APPLICABLE.value,
+            spec_parameter_id=spec_id,
+            spec_parameter_name=spec_name,
+            alert_message=f"No numeric result provided for {spec_type} parameter",
+            result_value=result_value,
+        )
+
+    op_min = spec_parameter.get("operational_limit_min")
+    op_max = spec_parameter.get("operational_limit_max")
+    rel_min = spec_parameter.get("release_limit_min")
+    rel_max = spec_parameter.get("release_limit_max")
+
+    # Build display string for spec limits
+    limit_parts = []
+    if rel_min is not None and rel_max is not None:
+        limit_parts.append(f"Release: {rel_min}–{rel_max} {unit}")
+    elif rel_max is not None:
+        limit_parts.append(f"Release: ≤ {rel_max} {unit}")
+    elif rel_min is not None:
+        limit_parts.append(f"Release: ≥ {rel_min} {unit}")
+
+    if op_min is not None and op_max is not None:
+        limit_parts.append(f"Operational: {op_min}–{op_max} {unit}")
+    elif op_max is not None:
+        limit_parts.append(f"Operational: ≤ {op_max} {unit}")
+    elif op_min is not None:
+        limit_parts.append(f"Operational: ≥ {op_min} {unit}")
+
+    spec_limit_display = "; ".join(limit_parts) if limit_parts else f"Spec: {spec_type}"
+
+    # Check release limits first (hard fail)
+    if rel_min is not None and result_numeric < rel_min:
+        return ValidationResult(
+            complies=False,
+            status=ValidationTier.FAIL.value,
+            limit_type=LimitType.RELEASE_BREACH.value,
+            spec_parameter_id=spec_id,
+            spec_parameter_name=spec_name,
+            alert_message=f"Result {result_numeric} {unit} below release limit {rel_min} {unit}",
+            result_value=result_value or str(result_numeric),
+            spec_limit_display=spec_limit_display,
+        )
+
+    if rel_max is not None and result_numeric > rel_max:
+        return ValidationResult(
+            complies=False,
+            status=ValidationTier.FAIL.value,
+            limit_type=LimitType.RELEASE_BREACH.value,
+            spec_parameter_id=spec_id,
+            spec_parameter_name=spec_name,
+            alert_message=f"Result {result_numeric} {unit} exceeds release limit {rel_max} {unit}",
+            result_value=result_value or str(result_numeric),
+            spec_limit_display=spec_limit_display,
+        )
+
+    # Check operational limits (alert)
+    if op_min is not None and result_numeric < op_min:
+        return ValidationResult(
+            complies=True,
+            status=ValidationTier.ALERT.value,
+            limit_type=LimitType.OPERATIONAL_BREACH.value,
+            spec_parameter_id=spec_id,
+            spec_parameter_name=spec_name,
+            alert_message=f"Result {result_numeric} {unit} below operational alert limit {op_min} {unit} — investigate, but within release spec",
+            result_value=result_value or str(result_numeric),
+            spec_limit_display=spec_limit_display,
+        )
+
+    if op_max is not None and result_numeric > op_max:
+        return ValidationResult(
+            complies=True,
+            status=ValidationTier.ALERT.value,
+            limit_type=LimitType.OPERATIONAL_BREACH.value,
+            spec_parameter_id=spec_id,
+            spec_parameter_name=spec_name,
+            alert_message=f"Result {result_numeric} {unit} exceeds operational alert limit {op_max} {unit} — investigate, but within release spec",
+            result_value=result_value or str(result_numeric),
+            spec_limit_display=spec_limit_display,
+        )
+
+    # All limits satisfied → PASS
+    return ValidationResult(
+        complies=True,
+        status=ValidationTier.PASS.value,
+        limit_type=LimitType.WITHIN_OPERATIONAL.value,
+        spec_parameter_id=spec_id,
+        spec_parameter_name=spec_name,
+        result_value=result_value or str(result_numeric),
+        spec_limit_display=spec_limit_display,
+    )
+
+
+def validate_batch_results(
+    results: list[dict],
+    spec_parameters: list[dict],
+) -> list[ValidationResult]:
+    """
+    Validate a batch of test results against their corresponding spec parameters.
+
+    Args:
+        results: List of dicts with keys: test_name, result_value, result_numeric.
+        spec_parameters: List of dicts matching SpecParameter model fields.
+
+    Returns:
+        List of ValidationResult objects — one per test result.
+    """
+    param_map = {}
+    for sp in spec_parameters:
+        name = sp.get("test_name_en", "")
+        param_map[name] = sp
+
+    validation_results = []
+    for result in results:
+        test_name = result.get("test_name", "")
+        spec_param = param_map.get(test_name)
+        vr = validate_result(
+            result_value=result.get("result_value"),
+            result_numeric=result.get("result_numeric"),
+            spec_parameter=spec_param,
+        )
+        validation_results.append(vr)
+
+    return validation_results
