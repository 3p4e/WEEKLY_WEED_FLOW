+"""
+Specification lifecycle state machine service.
+
+Per QCSOP 010 v02 §6.5 (review/approval workflow) and §6.6 (numbering after approval).
+
+State transitions:
+  DRAFT → ACTIVE (after QC_MANAGER and QA approval steps are complete)
+  ACTIVE → SUPERSEDED (when a new version is created for same material_code)
+  ACTIVE → WITHDRAWN (explicit QA decision, requires reason)
+  SUPERSEDED → WITHDRAWN (removed from archive reference)
+  WITHDRAWN → (terminal)
+
+Dual-activation guard: only ONE Specification may be ACTIVE per material_code at a time.
+Activating a new spec auto-supersedes the currently active one for the same material_code.
+
+Every state transition is logged to the AuditEntry table for GMP compliance.
+"""
+
+import logging
+import uuid
+from datetime import datetime, timezone
+
+from sqlalchemy import select, update
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.models.specification import (
+    SpecStatus,
+    SpecApproval,
+    ApprovalRole,
+    ApprovalStatusEnum,
+)
+from app.models.specification import Specification
+from app.models.audit import AuditEntry
+
+logger = logging.getLogger(__name__)
+
+# ── State transition map ─────────────────────────────────────────────────────
+
+SPEC_TRANSITIONS: dict[SpecStatus, list[SpecStatus]] = {
+    SpecStatus.DRAFT:       [SpecStatus.ACTIVE],
+    SpecStatus.ACTIVE:       [SpecStatus.SUPERSEDED, SpecStatus.WITHDRAWN],
+    SpecStatus.SUPERSEDED:   [SpecStatus.WITHDRAWN],
+    SpecStatus.WITHDRAWN:    [],
+}
+
+# Roles permitted to request each transition
+TRANSITION_ROLE_GATES: dict[tuple[SpecStatus, SpecStatus], list[str]] = {
+    (SpecStatus.DRAFT, SpecStatus.ACTIVE):       ["QC_MANAGER", "QA", "SYSTEM_ADMIN"],
+    (SpecStatus.ACTIVE, SpecStatus.SUPERSEDED):  ["QA", "SYSTEM_ADMIN"],
+    (SpecStatus.ACTIVE, SpecStatus.WITHDRAWN):   ["QA", "SYSTEM_ADMIN"],
+    (SpecStatus.SUPERSEDED, SpecStatus.WITHDRAWN): ["QA", "SYSTEM_ADMIN"],
+}
+
+
+def validate_transition(
+    current_status: SpecStatus,
+    target_status: SpecStatus,
+    user_role: str | None = None,
+) -> None:
+    """
+    Validate a proposed state transition.
+
+    Args:
+        current_status: Current specification status.
+        target_status: Desired specification status.
+        user_role: Role of the user requesting the transition (optional check).
+
+    Raises:
+        ValueError: If the transition is not allowed.
+    """
+    allowed = SPEC_TRANSITIONS.get(current_status, [])
+
+    if target_status not in allowed:
+        raise ValueError(
+            f"Invalid state transition: '{current_status.value}' → "
+            f"'{target_status.value}'. Allowed: "
+            f"{[s.value for s in allowed]}"
+        )
+
+    if user_role is not None:
+        gate = TRANSITION_ROLE_GATES.get((current_status, target_status), [])
+        if gate and user_role not in gate:
+            raise ValueError(
+                f"User role '{user_role}' is not permitted to perform "
+                f"'{current_status.value}' → '{target_status.value}' transition. "
+                f"Required: {gate}"
+            )
+
+
+async def transition_spec(
+    session: AsyncSession,
+    spec: Specification,
+    target_status: SpecStatus,
+    user_id: uuid.UUID,
+    user_role: str,
+    reason: str,
+) -> Specification:
+    """
+    Transition a specification to a new status with full audit logging.
+
+    Args:
+        session: Async database session.
+        spec: The specification to transition.
+        target_status: Desired new status.
+        user_id: UUID of the user performing the transition.
+        user_role: Role of the user (for permission check).
+        reason: Human-readable reason for the transition (GMP required).
+
+    Returns:
+        The updated Specification with new status.
+
+    Raises:
+        ValueError: If the transition is invalid.
+    """
+    current_status = SpecStatus(spec.status)
+
+    validate_transition(current_status, target_status, user_role)
+
+    # ── Dual-activation guard ────────────────────────────────────────────
+    if target_status == SpecStatus.ACTIVE:
+        existing_active = await session.execute(
+            select(Specification)
+            .where(Specification.material_code == spec.material_code)
+            .where(Specification.status == SpecStatus.ACTIVE.value)
+            .where(Specification.id != spec.id)
+            .where(Specification.is_deleted.is_(False))
+        )
+        active_spec = existing_active.scalars().first()
+
+        if active_spec is not None:
+            # Auto-supersede the currently active spec
+            old_status = active_spec.status
+            active_spec.status = SpecStatus.SUPERSEDED.value
+            active_spec.updated_at = datetime.now(timezone.utc)
+
+            # Audit log the auto-supersede
+            audit_entry = AuditEntry(
+                user_id=user_id,
+                action="UPDATE",
+                record_type="specification",
+                record_id=str(active_spec.id),
+                record_identifier=active_spec.spec_id,
+                field_name="status",
+                old_value=old_status,
+                new_value=SpecStatus.SUPERSEDED.value,
+                reason=f"Auto-superseded by activation of {spec.spec_id}: {reason}",
+            )
+            session.add(audit_entry)
+
+    # ── Apply transition ─────────────────────────────────────────────────
+    old_status_value = spec.status
+    spec.status = target_status.value
+    spec.updated_at = datetime.now(timezone.utc)
+
+    # ── Audit log ────────────────────────────────────────────────────────
+    audit_entry = AuditEntry(
+        user_id=user_id,
+        action="UPDATE",
+        record_type="specification",
+        record_id=str(spec.id),
+        record_identifier=spec.spec_id,
+        field_name="status",
+        old_value=old_status_value,
+        new_value=target_status.value,
+        reason=reason,
+    )
+    session.add(audit_entry)
+
+    await session.flush()
+    logger.info(
+        f"Specification {spec.spec_id}: "
+        f"{old_status_value} → {target_status.value} "
+        f"by user {user_id} ({user_role})"
+    )
+
+    return spec
+
+
+async def submit_for_review(
+    session: AsyncSession,
+    spec: Specification,
+    user_id: uuid.UUID,
+) -> Specification:
+    """
+    Submit a draft specification for review.
+
+    Creates a SpecApproval record for AUTHOR self-review + QC_MANAGER review.
+    The spec remains in DRAFT until all approvals are complete, then can be
+    transitioned to ACTIVE.
+
+    Args:
+        session: Async database session.
+        spec: The specification to submit.
+        user_id: UUID of the user submitting.
+
+    Returns:
+        The specification with updated approval records.
+    """
+    if SpecStatus(spec.status) != SpecStatus.DRAFT:
+        raise ValueError(
+            f"Only DRAFT specifications can be submitted for review. "
+            f"Current status: {spec.status}"
+        )
+
+    # Self-review (AUTHOR)
+    author_approval = SpecApproval(
+        spec_id=spec.id,
+        role=ApprovalRole.AUTHOR.value,
+        user_id=user_id,
+        status=ApprovalStatusEnum.PENDING.value,
+    )
+    session.add(author_approval)
+
+    # QC Manager review
+    qc_approval = SpecApproval(
+        spec_id=spec.id,
+        role=ApprovalRole.QC_MANAGER.value,
+        user_id=user_id,  # Will be reassigned to actual QC Manager
+        status=ApprovalStatusEnum.PENDING.value,
+    )
+    session.add(qc_approval)
+
+    # QA approval
+    qa_approval = SpecApproval(
+        spec_id=spec.id,
+        role=ApprovalRole.QA.value,
+        user_id=user_id,  # Will be reassigned to actual QA
+        status=ApprovalStatusEnum.PENDING.value,
+    )
+    session.add(qa_approval)
+
+    await session.flush()
+    logger.info(f"Specification {spec.spec_id} submitted for review by user {user_id}")
+
+    return spec
+
+
+async def approve_step(
+    session: AsyncSession,
+    spec: Specification,
+    approval_role: ApprovalRole,
+    user_id: uuid.UUID,
+    comments: str | None = None,
+) -> Specification:
+    """
+    Approve a specific approval step (AUTHOR/QC_MANAGER/QA).
+
+    Args:
+        session: Async database session.
+        spec: The specification being approved.
+        approval_role: Which role step to approve.
+        user_id: UUID of the approving user.
+        comments: Optional reviewer comments.
+
+    Returns:
+        The updated specification.
+    """
+    # Find the pending approval for this role
+    result = await session.execute(
+        select(SpecApproval)
+        .where(SpecApproval.spec_id == spec.id)
+        .where(SpecApproval.role == approval_role.value)
+        .where(SpecApproval.status == ApprovalStatusEnum.PENDING.value)
+    )
+    approval = result.scalars().first()
+
+    if approval is None:
+        raise ValueError(
+            f"No pending {approval_role.value} approval found for spec {spec.spec_id}"
+        )
+
+    approval.status = ApprovalStatusEnum.APPROVED.value
+    approval.user_id = user_id
+    approval.comments = comments
+    approval.signed_at = datetime.now(timezone.utc)
+
+    # Check if all approvals are complete
+    all_result = await session.execute(
+        select(SpecApproval)
+        .where(SpecApproval.spec_id == spec.id)
+    )
+    all_approvals = all_result.scalars().all()
+
+    all_done = all(
+        a.status == ApprovalStatusEnum.APPROVED.value for a in all_approvals
+    )
+
+    if all_done and SpecStatus(spec.status) == SpecStatus.DRAFT:
+        # All approvals complete — spec can now be activated
+        spec.status = SpecStatus.ACTIVE.value
+        spec.approved_by_id = user_id
+        spec.updated_at = datetime.now(timezone.utc)
+
+        # Audit log
+        audit_entry = AuditEntry(
+            user_id=user_id,
+            action="APPROVE",
+            record_type="specification",
+            record_id=str(spec.id),
+            record_identifier=spec.spec_id,
+            field_name="status",
+            old_value=SpecStatus.DRAFT.value,
+            new_value=SpecStatus.ACTIVE.value,
+            reason="All approval steps completed",
+        )
+        session.add(audit_entry)
+
+    await session.flush()
+    logger.info(
+        f"Specification {spec.spec_id}: {approval_role.value} approved by user {user_id}"
+    )
+
+    return spec
